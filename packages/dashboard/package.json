{
  "name": "@mega-ai-agent/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.web.json && tsgo --noEmit -p tsconfig.shell.json",
    "build": "bun run script/build.ts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "imports": {
    "#sqlite": {
      "bun": "./src/agent/sqlite.bun.ts",
      "node": "./src/agent/sqlite.node.ts",
      "default": "./src/agent/sqlite.bun.ts"
    }
  }
}
